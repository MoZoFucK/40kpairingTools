# Projet Supabase (Settings > API dans le dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète (sb_secret_...) — serveur uniquement, ne jamais exposer au navigateur.
# Nécessaire seulement pour le seed et les migrations. Laisser vide en local si inutilisé.
SUPABASE_SECRET_KEY=

# Comptes utilisés par les tests de bout en bout (npm run test:e2e).
# Des comptes de recette uniquement, jamais des comptes réels.
E2E_COACH_EMAIL=
E2E_COACH_PASSWORD=
E2E_PLAYER_EMAIL=
E2E_PLAYER_PASSWORD=
